// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  adapter  = "pg"
}

datasource db {
  provider = "postgresql"
}

// ユーザーテーブル（認証用）
model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // リレーション
  tasks       Task[]
  routines    Routine[]
  files       TaskFile[]

  @@map("users")
}

// タスクテーブル
model Task {
  id              Int       @id @default(autoincrement())
  title           String
  deadline        DateTime?
  priority        Int       @default(3) // 1-3, 低から高
  duration_minutes Int      @default(0)
  is_completed    Boolean   @default(false)
  tag             String?   // 任意のカテゴリ用タグ
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // ユーザーとの関連
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 親子階層（自己参照）
  parent_id       Int?
  parent          Task?     @relation("ParentChild", fields: [parent_id], references: [id], onDelete: Cascade)
  children        Task[]    @relation("ParentChild")

  // ファイル紐付け
  files           TaskFile[]

  @@index([userId])
  @@index([parent_id])
  @@map("tasks")
}

// ルーチンテーブル（ルーティン自動生成用）
model Routine {
  id            Int       @id @default(autoincrement())
  title         String
  interval_days Int       @default(1)
  priority      Int       @default(3)
  duration_minutes Int    @default(0)
  last_run_at   DateTime?
  is_active     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  frequency     String    @default("daily") // daily, weekday, weekend, weekly, biweekly, 3months, 6months, yearly
  endDate       DateTime? // 終了期限

  // ユーザーとの関連
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 完了履歴とのリレーション
  completions   RoutineCompletion[]

  @@index([userId])
  @@map("routines")
}

// タスクに紐付けたファイル
model TaskFile {
  id        Int       @id @default(autoincrement())
  filename  String
  filepath  String    // サーバーでの保存パス
  filesize  Int
  mimetype  String
  createdAt DateTime  @default(now())

  // タスクとの関連
  taskId    Int
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // ユーザーとの関連
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@map("task_files")
}

// ルーティンごとの日別完了ログ
model RoutineCompletion {
  id        Int      @id @default(autoincrement())
  date      String   // "YYYY-MM-DD" 形式
  routineId Int
  routine   Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([routineId, date])
  @@index([routineId])
  @@map("routine_completions")
}
