<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>登録 - ToDoリスト</title>
  <!-- 可読性の高い Google Fonts Noto Sans JP & Inter の読み込み -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --theme-color: #FF3399;
      --theme-color-hover: #e60080;
      --theme-color-shadow: rgba(255, 51, 153, 0.3);
      --theme-color-light: rgba(255, 51, 153, 0.1);
      --theme-text-color: #ffffff;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', 'Noto Sans JP', sans-serif;
      background: #f5f5f5;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      transition: background-color 0.3s, color 0.3s;
    }

    /* ダークモード */
    body.dark-mode {
      background: #121212;
      color: #e0e0e0;
    }

    body.dark-mode .container {
      background: #1e1e1e;
      border-top-color: var(--theme-color);
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
    }

    body.dark-mode h1 {
      color: #ffffff;
    }

    body.dark-mode label {
      color: #aaa;
    }

    body.dark-mode input[type="email"],
    body.dark-mode input[type="password"],
    body.dark-mode input[type="text"] {
      background: #252525;
      border-color: #333;
      color: #ffffff;
    }

    body.dark-mode input[type="email"]:focus,
    body.dark-mode input[type="password"]:focus,
    body.dark-mode input[type="text"]:focus {
      border-color: var(--theme-color);
    }

    body.dark-mode .link-group {
      color: #aaa;
    }

    /* 共通コンテナ */
    .container {
      background: white;
      border-radius: 16px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
      max-width: 400px;
      width: 100%;
      padding: 40px;
      border-top: 4px solid var(--theme-color);
      transition: border-top-color 0.3s;
    }

    h1 {
      color: #000;
      margin-bottom: 30px;
      text-align: center;
      font-size: 1.8em;
      font-weight: 600;
    }

    .form-group {
      margin-bottom: 20px;
    }

    label {
      display: block;
      color: #666;
      margin-bottom: 8px;
      font-weight: 600;
      font-size: 0.9em;
    }

    input[type="email"],
    input[type="password"],
    input[type="text"] {
      width: 100%;
      padding: 12px;
      border: 2px solid #f0f0f0;
      border-radius: 8px;
      font-size: 1em;
      transition: all 0.3s;
      font-family: inherit;
    }

    input[type="email"]:focus,
    input[type="password"]:focus,
    input[type="text"]:focus {
      outline: none;
      border-color: var(--theme-color);
      box-shadow: 0 0 0 3px var(--theme-color-light);
    }

    button {
      width: 100%;
      padding: 14px;
      background: var(--theme-color);
      color: var(--theme-text-color);
      border: none;
      border-radius: 8px;
      font-size: 1em;
      cursor: pointer;
      transition: all 0.3s;
      font-weight: 600;
      font-family: inherit;
    }

    button:hover {
      background: var(--theme-color-hover);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px var(--theme-color-shadow);
    }

    button:disabled {
      background: #ccc;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }

    .link-group {
      text-align: center;
      margin-top: 20px;
      color: #666;
      font-size: 0.9em;
      font-weight: 500;
    }

    .link-group a {
      color: var(--theme-color);
      text-decoration: none;
      font-weight: 600;
      margin-left: 5px;
      transition: color 0.3s;
    }

    .link-group a:hover {
      text-decoration: underline;
    }

    .error-message {
      background: #ffe8e8;
      color: #c0392b;
      padding: 12px;
      border-radius: 8px;
      margin-bottom: 20px;
      display: none;
      font-weight: 500;
      font-size: 0.9em;
    }

    .success-message {
      background: #eafaf1;
      color: #27ae60;
      padding: 12px;
      border-radius: 8px;
      margin-bottom: 20px;
      display: none;
      font-weight: 500;
      font-size: 0.9em;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>アカウント作成</h1>

    <div class="error-message" id="errorMessage"></div>
    <div class="success-message" id="successMessage"></div>

    <form id="registerForm">
      <div class="form-group">
        <label for="name">名前（オプション）</label>
        <input type="text" id="name" name="name">
      </div>

      <div class="form-group">
        <label for="email">メールアドレス</label>
        <input type="email" id="email" name="email" required>
      </div>

      <div class="form-group">
        <label for="password">パスワード</label>
        <input type="password" id="password" name="password" required>
      </div>

      <div class="form-group">
        <label for="confirmPassword">パスワード確認</label>
        <input type="password" id="confirmPassword" name="confirmPassword" required>
      </div>

      <button type="submit" id="submitBtn">登録</button>
    </form>

    <div class="link-group">
      すでにアカウントをお持ちの方は
      <a href="/login">ログイン</a>
    </div>
  </div>

  <script>
    // 保存されたテーマを適用
    const loadSavedTheme = () => {
      const primary = localStorage.getItem('theme-color') || '#FF3399';
      const hover = localStorage.getItem('theme-color-hover') || '#e60080';
      const shadow = localStorage.getItem('theme-color-shadow') || 'rgba(255, 51, 153, 0.3)';
      const light = localStorage.getItem('theme-color-light') || 'rgba(255, 51, 153, 0.1)';
      const textColor = localStorage.getItem('theme-text-color') || '#ffffff';

      document.documentElement.style.setProperty('--theme-color', primary);
      document.documentElement.style.setProperty('--theme-color-hover', hover);
      document.documentElement.style.setProperty('--theme-color-shadow', shadow);
      document.documentElement.style.setProperty('--theme-color-light', light);
      document.documentElement.style.setProperty('--theme-text-color', textColor);

      // ダークモードの同期
      if (localStorage.getItem('dark-mode') === 'true') {
        document.body.classList.add('dark-mode');
      }
    };
    loadSavedTheme();

    const form = document.getElementById('registerForm');
    const errorEl = document.getElementById('errorMessage');
    const successEl = document.getElementById('successMessage');
    const submitBtn = document.getElementById('submitBtn');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const name = document.getElementById('name').value;
      const email = document.getElementById('email').value;
      const password = document.getElementById('password').value;
      const confirmPassword = document.getElementById('confirmPassword').value;

      errorEl.style.display = 'none';
      successEl.style.display = 'none';

      // パスワード確認
      if (password !== confirmPassword) {
        errorEl.textContent = 'パスワードが一致しません';
        errorEl.style.display = 'block';
        return;
      }

      // パスワード長さ確認
      if (password.length < 6) {
        errorEl.textContent = 'パスワードは6文字以上である必要があります';
        errorEl.style.display = 'block';
        return;
      }

      submitBtn.disabled = true;

      try {
        const response = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password, name }),
        });

        const data = await response.json();

        if (!response.ok) {
          errorEl.textContent = data.error || '登録に失敗しました';
          errorEl.style.display = 'block';
          submitBtn.disabled = false;
          return;
        }

        successEl.textContent = 'アカウントが作成されました！ログインしています...';
        successEl.style.display = 'block';

        // 1秒後にリダイレクト
        setTimeout(() => {
          window.location.href = `/?userId=${data.userId}&isNew=true`;
        }, 1000);
      } catch (err) {
        console.error(err);
        errorEl.textContent = 'エラーが発生しました';
        errorEl.style.display = 'block';
        submitBtn.disabled = false;
      }
    });
  </script>
</body>
</html>