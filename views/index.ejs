  <script>
    // 時セレクトボックスの初期化
    const initHourSelect = (selectId) => {
      const select = document.getElementById(selectId);
      select.innerHTML = '';
      for (let h = 0; h < 24; h++) {
        const val = String(h).padStart(2, '0');
        select.innerHTML += `<option value="${val}">${val}時</option>`;
      }
    };

    initHourSelect('deadlineHour');
    initHourSelect('editDeadlineHour');

    // 動的テーマカラー・ダークモード設定・コントラスト自動計算
    const updateThemeColors = (hexColor) => {
      const primary = hexColor;
      const r = parseInt(primary.slice(1, 3), 16);
      const g = parseInt(primary.slice(3, 5), 16);
      const b = parseInt(primary.slice(5, 7), 16);

      const yiq = ((r * 299) + (g * 587) + (b * 114)) / 1000;
      const textColor = (yiq >= 128) ? '#000000' : '#ffffff';

      const darken = (val) => Math.max(0, Math.floor(val * 0.8));
      const hover = `rgb(${darken(r)}, ${darken(g)}, ${darken(b)})`;
      const shadow = `rgba(${r}, ${g}, ${b}, 0.3)`;
      const light = `rgba(${r}, ${g}, ${b}, 0.1)`;
      const border = `rgba(${r}, ${g}, ${b}, 0.35)`;

      document.documentElement.style.setProperty('--theme-color', primary);
      document.documentElement.style.setProperty('--theme-color-hover', hover);
      document.documentElement.style.setProperty('--theme-color-shadow', shadow);
      document.documentElement.style.setProperty('--theme-color-light', light);
      document.documentElement.style.setProperty('--theme-color-border', border);
      document.documentElement.style.setProperty('--theme-text-color', textColor);

      localStorage.setItem('theme-color', primary);
      localStorage.setItem('theme-color-hover', hover);
      localStorage.setItem('theme-color-shadow', shadow);
      localStorage.setItem('theme-color-light', light);
      localStorage.setItem('theme-color-border', border);
      localStorage.setItem('theme-text-color', textColor);

      // カラーサークルの active 表示切り替え
      document.querySelectorAll('.color-circle').forEach(circle => {
        if (circle.getAttribute('data-color').toLowerCase() === primary.toLowerCase()) {
          circle.classList.add('active');
        } else {
          circle.classList.remove('active');
        }
      });
    };

    const toggleDarkMode = (isDark) => {
      if (isDark) {
        document.body.classList.add('dark-mode');
        localStorage.setItem('dark-mode', 'true');
      } else {
        document.body.classList.remove('dark-mode');
        localStorage.setItem('dark-mode', 'false');
      }
      document.getElementById('darkModeToggle').checked = isDark;
    };

    const loadSavedTheme = () => {
      const primary = localStorage.getItem('theme-color') || '#FF3399';
      updateThemeColors(primary);

      const isDark = localStorage.getItem('dark-mode') === 'true';
      toggleDarkMode(isDark);
    };

    loadSavedTheme();

    let tasks = [];
    let routines = [];
    let completions = [];
    let filter = 'all';
    let selectedTag = null;
    let sortBy = 'created';
    let currentParentId = null;
    let editingTaskId = null;

    let currentYear = new Date().getFullYear();
    let currentMonth = new Date().getMonth();

    const userId = new URLSearchParams(window.location.search).get('userId');

    if (!userId) {
      window.location.href = '/login';
    }

    const toggleAllDay = (checked, isEdit = false) => {
      const hourSelect = document.getElementById(isEdit ? 'editDeadlineHour' : 'deadlineHour');
      const minuteSelect = document.getElementById(isEdit ? 'editDeadlineMinute' : 'deadlineMinute');
      if (checked) {
        hourSelect.style.display = 'none';
        minuteSelect.style.display = 'none';
      } else {
        hourSelect.style.display = 'block';
        minuteSelect.style.display = 'block';
      }
    };

    const getPriorityLabel = (priority) => {
      const labels = { 1: '超緊急', 2: '高', 3: '中', 4: '低' };
      return labels[priority] || '不明';
    };

    const getPriorityClass = (priority) => {
      const classes = { 1: 'priority-critical', 2: 'priority-high', 3: 'priority-medium', 4: 'priority-low' };
      return classes[priority] || '';
    };

    const getCountdownInfo = (deadline) => {
      if (!deadline) return { text: '期限なし', class: '', daysLeft: null };

      const now = new Date();
      const deadlineDate = new Date(deadline);
      const diffTime = deadlineDate - now;

      const formatDeadline = (d) => {
        const month = d.getMonth() + 1;
        const date = d.getDate();
        
        const isAllDay = d.getHours() === 23 && d.getMinutes() === 59;
        if (isAllDay) {
          return `${month}/${date}`;
        }
        
        const hours = String(d.getHours()).padStart(2, '0');
        const minutes = String(d.getMinutes()).padStart(2, '0');
        return `${month}/${date} ${hours}:${minutes}`;
      };

      if (diffTime < 0) {
        return { text: `期限切れ (${formatDeadline(deadlineDate)})`, class: 'overdue', daysLeft: -1 };
      }

      const diffHours = Math.floor(diffTime / (1000 * 60 * 60));
      const diffMinutes = Math.floor((diffTime / (1000 * 60)) % 60);

      if (diffHours < 24) {
        if (diffHours === 0) {
          return { text: `あと${diffMinutes}分 (${formatDeadline(deadlineDate)})`, class: 'urgent', daysLeft: 0 };
        }
        return { text: `あと${diffHours}時間${diffMinutes}分 (${formatDeadline(deadlineDate)})`, class: 'urgent', daysLeft: 0 };
      }

      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
      if (diffDays <= 3) {
        return { text: `あと${diffDays}日 (${formatDeadline(deadlineDate)})`, class: 'urgent', daysLeft: diffDays };
      } else if (diffDays <= 7) {
        return { text: `あと${diffDays}日 (${formatDeadline(deadlineDate)})`, class: 'warning', daysLeft: diffDays };
      } else {
        return { text: `あと${diffDays}日 (${formatDeadline(deadlineDate)})`, class: 'safe', daysLeft: diffDays };
      }
    };

    const showError = (message) => {
      const errorEl = document.getElementById('errorMessage');
      errorEl.textContent = message;
      errorEl.style.display = 'block';
      setTimeout(() => {
        errorEl.style.display = 'none';
      }, 5000);
    };

    const logout = () => {
      window.location.href = '/login';
    };

    const openAddModal = () => {
      document.getElementById('addModal').classList.add('show');
      updateModalTagChips();
    };

    const closeAddModal = () => {
      document.getElementById('addModal').classList.remove('show');
      document.getElementById('taskInput').value = '';
      document.getElementById('deadlineDate').value = '';
      document.getElementById('deadlineHour').value = '00';
      document.getElementById('deadlineMinute').value = '00';
      document.getElementById('deadlineHour').style.display = 'block';
      document.getElementById('deadlineMinute').style.display = 'block';
      document.getElementById('allDayCheckbox').checked = false;
      document.getElementById('durationInput').value = '0';
      document.getElementById('tagInput').value = '';
      document.getElementById('priorityInput').value = '4';
    };

    const openEditModal = (id) => {
      const task = tasks.find(t => t.id === id);
      if (!task) return;

      editingTaskId = id;
      document.getElementById('editTaskInput').value = task.title;

      if (task.deadline) {
        const d = new Date(task.deadline);
        const year = d.getFullYear();
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const date = String(d.getDate()).padStart(2, '0');
        document.getElementById('editDeadlineDate').value = `${year}-${month}-${date}`;

        const isAllDay = d.getHours() === 23 && d.getMinutes() === 59;
        document.getElementById('editAllDayCheckbox').checked = isAllDay;
        
        if (isAllDay) {
          document.getElementById('editDeadlineHour').value = '00';
          document.getElementById('editDeadlineMinute').value = '00';
          document.getElementById('editDeadlineHour').style.display = 'none';
          document.getElementById('editDeadlineMinute').style.display = 'none';
        } else {
          const hours = String(d.getHours()).padStart(2, '0');
          const minutes = String(d.getMinutes()).padStart(2, '0');
          let roundedMin = '00';
          if (['00','10','20','30','40','50','59'].includes(minutes)) {
            roundedMin = minutes;
          } else {
            const m = parseInt(minutes);
            if (m > 54) roundedMin = '59';
            else roundedMin = String(Math.round(m / 10) * 10).padStart(2, '0');
          }
          document.getElementById('editDeadlineHour').value = hours;
          document.getElementById('editDeadlineMinute').value = roundedMin;
          document.getElementById('editDeadlineHour').style.display = 'block';
          document.getElementById('editDeadlineMinute').style.display = 'block';
        }
      } else {
        document.getElementById('editDeadlineDate').value = '';
        document.getElementById('editDeadlineHour').value = '00';
        document.getElementById('editDeadlineMinute').value = '00';
        document.getElementById('editDeadlineHour').style.display = 'block';
        document.getElementById('editDeadlineMinute').style.display = 'block';
        document.getElementById('editAllDayCheckbox').checked = false;
      }

      document.getElementById('editDurationInput').value = task.duration_minutes || '0';
      document.getElementById('editTagInput').value = task.tag || '';
      document.getElementById('editPriorityInput').value = task.priority;
      document.getElementById('editModal').classList.add('show');
      updateModalTagChips();
    };

    const closeEditModal = () => {
      document.getElementById('editModal').classList.remove('show');
      editingTaskId = null;
    };

    const openSubtaskModal = (parentId) => {
      currentParentId = parentId;
      document.getElementById('subtaskModal').classList.add('show');
      document.getElementById('subtaskInput').focus();
    };

    const closeSubtaskModal = () => {
      document.getElementById('subtaskModal').classList.remove('show');
      document.getElementById('subtaskInput').value = '';
      currentParentId = null;
    };

    const openRoutineModal = () => {
      document.getElementById('routineModal').classList.add('show');
    };

    const closeRoutineModal = () => {
      document.getElementById('routineModal').classList.remove('show');
      document.getElementById('routineInput').value = '';
      document.getElementById('routineFrequency').value = 'daily';
      document.getElementById('routineEndDate').value = '';
    };

    // ========== API 連携 ==========

    const handleAddTask = async (e) => {
      e.preventDefault();

      const input = document.getElementById('taskInput');
      const dateVal = document.getElementById('deadlineDate').value;
      const hourVal = document.getElementById('deadlineHour').value;
      const minuteVal = document.getElementById('deadlineMinute').value;
      const duration = document.getElementById('durationInput');
      const tag = document.getElementById('tagInput').value.trim() || null;
      const priority = document.getElementById('priorityInput');
      const allDay = document.getElementById('allDayCheckbox').checked;
      const submitBtn = document.getElementById('submitBtn');

      submitBtn.disabled = true;

      let deadlineValue = null;
      if (dateVal) {
        if (allDay) {
          deadlineValue = `${dateVal}T23:59:59`;
        } else {
          deadlineValue = `${dateVal}T${hourVal}:${minuteVal}:00`;
        }
      }

      try {
        const response = await fetch('/api/tasks', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title: input.value.trim(),
            deadline: deadlineValue,
            priority: parseInt(priority.value),
            duration_minutes: parseInt(duration.value) || 0,
            tag,
            userId: parseInt(userId),
          }),
        });

        if (!response.ok) throw new Error('Failed to create task');

        const newTask = await response.json();
        tasks.push(newTask);
        render();
        renderTagFilters();
        updateModalTagChips();
        closeAddModal();
      } catch (err) {
        console.error(err);
        showError('タスクの作成に失敗しました');
      } finally {
        submitBtn.disabled = false;
      }
    };

    const handleEditTask = async (e) => {
      e.preventDefault();
      if (!editingTaskId) return;

      const title = document.getElementById('editTaskInput').value.trim();
      const dateVal = document.getElementById('editDeadlineDate').value;
      const hourVal = document.getElementById('editDeadlineHour').value;
      const minuteVal = document.getElementById('editDeadlineMinute').value;
      const duration = document.getElementById('editDurationInput');
      const tag = document.getElementById('editTagInput').value.trim() || null;
      const priority = document.getElementById('editPriorityInput');
      const allDay = document.getElementById('editAllDayCheckbox').checked;
      const submitBtn = document.getElementById('editSubmitBtn');

      submitBtn.disabled = true;

      let deadlineValue = null;
      if (dateVal) {
        if (allDay) {
          deadlineValue = `${dateVal}T23:59:59`;
        } else {
          deadlineValue = `${dateVal}T${hourVal}:${minuteVal}:00`;
        }
      }

      try {
        const response = await fetch(`/api/tasks/${editingTaskId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title,
            deadline: deadlineValue,
            priority: parseInt(priority.value),
            duration_minutes: parseInt(duration.value) || 0,
            tag,
          }),
        });

        if (!response.ok) throw new Error('Failed to update task');

        const updatedTask = await response.json();
        tasks = tasks.map(t => t.id === editingTaskId ? updatedTask : t);

        if (selectedTag && !tasks.some(t => t.tag === selectedTag)) {
          selectedTag = null;
        }

        render();
        renderTagFilters();
        updateModalTagChips();
        closeEditModal();
      } catch (err) {
        console.error(err);
        showError('タスクの編集に失敗しました');
      } finally {
        submitBtn.disabled = false;
      }
    };

    const handleAddSubtask = async (e) => {
      e.preventDefault();

      const input = document.getElementById('subtaskInput');
      const submitBtn = e.target.querySelector('.btn-submit');

      submitBtn.disabled = true;

      try {
        const response = await fetch('/api/tasks', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title: input.value.trim(),
            parent_id: currentParentId,
            userId: parseInt(userId),
            deadline: null,
            duration_minutes: 0,
            priority: 4,
          }),
        });

        if (!response.ok) throw new Error('Failed to create subtask');

        const newSubtask = await response.json();
        tasks.push(newSubtask);
        render();
        closeSubtaskModal();
      } catch (err) {
        console.error(err);
        showError('子タスクの作成に失敗しました');
      } finally {
        submitBtn.disabled = false;
      }
    };

    const loadTasks = async () => {
      try {
        const response = await fetch(`/api/tasks?userId=${userId}`);
        if (!response.ok) throw new Error('Failed to load tasks');
        tasks = await response.json();
        render();
        renderTagFilters();
        updateModalTagChips();
      } catch (err) {
        console.error(err);
        showError('タスクの読み込みに失敗しました');
      }
    };

    const toggleTask = async (id) => {
      const task = tasks.find(t => t.id === id);
      if (!task) return;

      try {
        const response = await fetch(`/api/tasks/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            ...task,
            is_completed: !task.is_completed,
          }),
        });

        if (!response.ok) throw new Error('Failed to update task');

        task.is_completed = !task.is_completed;

        if (task.is_completed && !task.parent_id) {
          const subtasks = tasks.filter(t => t.parent_id === task.id);
          for (const subtask of subtasks) {
            await deleteTask(subtask.id, true);
          }
        }

        render();
      } catch (err) {
        console.error(err);
        showError('タスクの更新に失敗しました');
      }
    };

    const deleteTask = async (id, silent = false) => {
      if (!silent && !confirm('このタスクを削除してもよろしいですか？')) return;

      try {
        const response = await fetch(`/api/tasks/${id}`, {
          method: 'DELETE',
        });

        if (!response.ok) throw new Error('Failed to delete task');

        tasks = tasks.filter(t => t.id !== id);
        
        if (selectedTag && !tasks.some(t => t.tag === selectedTag)) {
          selectedTag = null;
        }

        if (!silent) {
          render();
          renderTagFilters();
          updateModalTagChips();
        }
      } catch (err) {
        console.error(err);
        if (!silent) showError('タスクの削除に失敗しました');
      }
    };

    // ========== ルーティン・カレンダーロジック ==========

    const handleAddRoutine = async (e) => {
      e.preventDefault();
      const input = document.getElementById('routineInput');
      const frequency = document.getElementById('routineFrequency').value;
      const endDate = document.getElementById('routineEndDate').value;
      const submitBtn = document.getElementById('routineSubmitBtn');

      submitBtn.disabled = true;

      let endDateTime = null;
      if (endDate) {
        endDateTime = `${endDate}T23:59:59`;
      }

      try {
        const response = await fetch('/api/routines', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title: input.value.trim(),
            frequency,
            endDate: endDateTime,
            userId: parseInt(userId),
          }),
        });

        if (!response.ok) throw new Error('Failed to create routine');

        const newRoutine = await response.json();
        routines.push(newRoutine);
        renderRoutines();
        renderCalendar();
        checkRoutineCompletion();
        closeRoutineModal();
      } catch (err) {
        console.error(err);
        showError('ルーティンの作成に失敗しました');
      } finally {
        submitBtn.disabled = false;
      }
    };

    const toggleRoutine = async (id, checked) => {
      const todayStr = getTodayStr();
      try {
        const response = await fetch(`/api/routines/${id}/toggle`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ completed: checked, date: todayStr }),
        });

        if (!response.ok) throw new Error('Failed to toggle routine');

        const updated = await response.json();
        routines = routines.map(r => r.id === id ? updated : r);

        if (checked) {
          completions.push({ routineId: id, date: todayStr });
        } else {
          completions = completions.filter(c => !(c.routineId === id && c.date === todayStr));
        }

        renderRoutines();
        renderCalendar();
        checkRoutineCompletion();
      } catch (err) {
        console.error(err);
        showError('ルーティンの更新に失敗しました');
      }
    };

    const deleteRoutine = async (id) => {
      if (!confirm('このルーティンを削除してもよろしいですか？')) return;

      try {
        const response = await fetch(`/api/routines/${id}`, {
          method: 'DELETE',
        });

        if (!response.ok) throw new Error('Failed to delete routine');

        routines = routines.filter(r => r.id !== id);
        completions = completions.filter(c => c.routineId !== id);

        renderRoutines();
        renderCalendar();
        checkRoutineCompletion();
      } catch (err) {
        console.error(err);
        showError('ルーティンの削除に失敗しました');
      }
    };

    const loadRoutines = async () => {
      try {
        const response = await fetch(`/api/routines?userId=${userId}`);
        routines = await response.json();
        renderRoutines();
        checkRoutineCompletion();
      } catch (err) {
        console.error(err);
      }
    };

    const loadCompletions = async () => {
      try {
        const response = await fetch(`/api/routines/completions?userId=${userId}`);
        completions = await response.json();
        renderCalendar();
        checkRoutineCompletion();
      } catch (err) {
        console.error(err);
      }
    };

    const getEffectiveRoutines = (dateStr) => {
      const targetDate = new Date(dateStr + "T00:00:00");
      const targetDay = targetDate.getDay();

      return routines.filter(routine => {
        const created = new Date(routine.createdAt);
        const createdZero = new Date(created.getFullYear(), created.getMonth(), created.getDate());
        
        if (targetDate < createdZero) return false;

        if (routine.endDate) {
          const ended = new Date(routine.endDate);
          const endedZero = new Date(ended.getFullYear(), ended.getMonth(), ended.getDate());
          if (targetDate > endedZero) return false;
        }

        switch (routine.frequency) {
          case 'daily':
            return true;
          case 'weekday':
            return targetDay >= 1 && targetDay <= 5;
          case 'weekend':
            return targetDay === 0 || targetDay === 6;
          case 'weekly':
            return targetDay === created.getDay();
          case 'biweekly':
            if (targetDay !== created.getDay()) return false;
            const diffTime = targetDate - createdZero;
            const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
            return (diffDays / 7) % 2 === 0;
          case '3months':
            if (targetDate.getDate() !== created.getDate()) return false;
            const mDiff3 = (targetDate.getFullYear() - created.getFullYear()) * 12 + (targetDate.getMonth() - created.getMonth());
            return mDiff3 % 3 === 0;
          case '6months':
            if (targetDate.getDate() !== created.getDate()) return false;
            const mDiff6 = (targetDate.getFullYear() - created.getFullYear()) * 12 + (targetDate.getMonth() - created.getMonth());
            return mDiff6 % 6 === 0;
          case 'yearly':
            return targetDate.getMonth() === created.getMonth() && targetDate.getDate() === created.getDate();
          default:
            return true;
        }
      });
    };

    const getCompletionRate = (dateStr) => {
      const effective = getEffectiveRoutines(dateStr);
      if (effective.length === 0) return null;

      const completedCount = completions.filter(c => c.date === dateStr && effective.some(r => r.id === c.routineId)).length;
      return Math.round((completedCount / effective.length) * 100);
    };

    const checkRoutineCompletion = () => {
      const todayStr = getTodayStr();
      const rate = getCompletionRate(todayStr);
      const msgEl = document.getElementById('congratsMessage');

      if (rate === 100) {
        msgEl.classList.add('show');
      } else {
        msgEl.classList.remove('show');
      }
    };

    const renderRoutines = () => {
      const list = document.getElementById('routineList');
      const todayStr = getTodayStr();
      const todayRoutines = getEffectiveRoutines(todayStr);

      if (todayRoutines.length === 0) {
        list.innerHTML = `
          <li style="text-align: center; color: #999; font-size: 0.9em; padding: 20px;">
            今日の予定ルーティンはありません
          </li>
        `;
        return;
      }

      list.innerHTML = todayRoutines.map(routine => {
        const isDone = completions.some(c => c.routineId === routine.id && c.date === todayStr);
        return `
          <li class="routine-item ${isDone ? 'completed' : ''}">
            <input type="checkbox" class="routine-checkbox" ${isDone ? 'checked' : ''} 
                   onchange="toggleRoutine(${routine.id}, this.checked)">
            <div class="routine-text">${routine.title}</div>
            <button class="btn-delete-routine" onclick="deleteRoutine(${routine.id})">削除</button>
          </li>
        `;
      }).join('');
    };

    const getTodayStr = () => {
      const d = new Date();
      const year = d.getFullYear();
      const month = String(d.getMonth() + 1).padStart(2, '0');
      const date = String(d.getDate()).padStart(2, '0');
      return `${year}-${month}-${date}`;
    };

    // ========== カレンダーロジック ==========

    const prevMonth = () => {
      currentMonth--;
      if (currentMonth < 0) {
        currentMonth = 11;
        currentYear--;
      }
      renderCalendar();
    };

    const nextMonth = () => {
      currentMonth++;
      if (currentMonth > 11) {
        currentMonth = 0;
        currentYear++;
      }
      renderCalendar();
    };

    const renderCalendar = () => {
      const grid = document.getElementById('calendarGrid');
      const title = document.getElementById('calendarTitle');
      grid.innerHTML = '';

      title.textContent = `${currentYear}年${currentMonth + 1}月`;

      const firstDay = new Date(currentYear, currentMonth, 1).getDay();
      const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();

      for (let i = 0; i < firstDay; i++) {
        grid.innerHTML += `<div class="calendar-day empty"></div>`;
      }

      for (let day = 1; day <= daysInMonth; day++) {
        const monthStr = String(currentMonth + 1).padStart(2, '0');
        const dayStr = String(day).padStart(2, '0');
        const dateKey = `${currentYear}-${monthStr}-${dayStr}`;

        const isToday = currentYear === new Date().getFullYear() &&
                        currentMonth === new Date().getMonth() &&
                        day === new Date().getDate();

        const rate = getCompletionRate(dateKey);
        let rateHtml = '';
        let styleClass = '';
        
        if (rate !== null) {
          rateHtml = `<span class="completion-rate">${rate}%</span>`;
          if (rate === 100) {
            styleClass = 'completed-all';
          }
        }

        grid.innerHTML += `
          <div class="calendar-day ${isToday ? 'today' : ''} ${styleClass}">
            <span class="day-number">${day}</span>
            ${rateHtml}
          </div>
        `;
      }
    };

    // ========== タスク操作共通 ==========

    const setFilter = (newFilter) => {
      filter = newFilter;
      selectedTag = null;
      document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.classList.remove('active');
      });
      event.target.classList.add('active');
      render();
      renderTagFilters();
    };

    const setSort = (newSort) => {
      sortBy = newSort;
      render();
    };

    const getFilteredTasks = () => {
      return tasks.filter(task => {
        if (task.parent_id) return false;
        
        if (filter === 'completed') {
          if (!task.is_completed) return false;
        } else {
          if (task.is_completed) return false;
        }
        
        if (filter === 'urgent') {
          const countdown = getCountdownInfo(task.deadline);
          const isUrgent = countdown.class === 'urgent' || countdown.class === 'overdue' || task.priority === 1;
          if (!isUrgent) return false;
        }

        if (selectedTag && task.tag !== selectedTag) {
          return false;
        }

        return true;
      });
    };

    const getSortedTasks = (tasksToSort) => {
      return tasksToSort.sort((a, b) => {
        if (sortBy === 'priority') {
          return a.priority - b.priority;
        }
        if (sortBy === 'deadline') {
          if (!a.deadline) return 1;
          if (!b.deadline) return -1;
          return new Date(a.deadline) - new Date(b.deadline);
        }
        return new Date(b.createdAt) - new Date(a.createdAt);
      });
    };

    const getUrgencyClass = (task) => {
      if (task.priority === 1) return 'critical';
      const countdown = getCountdownInfo(task.deadline);
      return countdown.class || '';
    };

    const selectTag = (tag) => {
      selectedTag = tag;
      render();
      renderTagFilters();
    };

    const renderTagFilters = () => {
      const container = document.getElementById('tagFilterContainer');
      
      const currentFilteredTasks = tasks.filter(task => {
        if (task.parent_id) return false;
        if (filter === 'completed') return task.is_completed;
        return !task.is_completed;
      });

      const activeTags = [...new Set(currentFilteredTasks.map(t => t.tag).filter(Boolean))];

      if (activeTags.length === 0) {
        container.style.display = 'none';
        container.innerHTML = '';
        return;
      }

      container.style.display = 'flex';
      container.innerHTML = `
        <span style="font-size: 0.85em; font-weight: 600; color: #666; margin-right: 5px;">タグ絞り込み:</span>
        <button class="filter-btn ${!selectedTag ? 'active' : ''}" onclick="selectTag(null)" style="padding: 4px 12px; font-size: 0.8em; border-radius: 12px;">すべて</button>
        ${activeTags.map(tag => `
          <button class="filter-btn ${selectedTag === tag ? 'active' : ''}" onclick="selectTag('${tag}')" style="padding: 4px 12px; font-size: 0.8em; border-radius: 12px;">#${tag}</button>
        `).join('')}
      `;
    };

    // タグ自動入力処理
    const setModalTagValue = (val, isEdit) => {
      const input = document.getElementById(isEdit ? 'editTagInput' : 'tagInput');
      if (input) {
        input.value = val;
      }
    };

    // モーダル用タグチップの更新
    const updateModalTagChips = () => {
      const activeTags = [...new Set(tasks.map(t => t.tag).filter(Boolean))];
      
      const chipsContainer = document.getElementById('addModalTagChips');
      const editChipsContainer = document.getElementById('editModalTagChips');
      
      if (chipsContainer && editChipsContainer) {
        if (activeTags.length === 0) {
          chipsContainer.innerHTML = '<span style="font-size:0.8em; color:#999;">登録済みのタグはありません</span>';
          editChipsContainer.innerHTML = '<span style="font-size:0.8em; color:#999;">登録済みのタグはありません</span>';
          return;
        }
        
        const renderChips = (isEdit) => {
          return activeTags.map(tag => `
            <span class="modal-tag-chip" onclick="setModalTagValue('${tag}', ${isEdit})">#${tag}</span>
          `).join('');
        };
        
        chipsContainer.innerHTML = renderChips(false);
        editChipsContainer.innerHTML = renderChips(true);
      }
    };

    const renderTaskItem = (task) => {
      const countdown = getCountdownInfo(task.deadline);
      const urgencyClass = getUrgencyClass(task);
      const tagBadge = task.tag ? `<span class="task-tag" onclick="selectTag('${task.tag}')">#${task.tag}</span>` : '';

      const subtasks = tasks.filter(t => t.parent_id === task.id);
      const subtaskHtml = subtasks.length > 0 ? `
        <ul class="subtask-list">
          ${subtasks.map(subtask => `
            <li class="subtask-item ${subtask.is_completed ? 'completed' : ''}">
              <input type="checkbox" style="width: 16px; height: 16px; accent-color: var(--theme-color);" ${subtask.is_completed ? 'checked' : ''} 
                     onchange="toggleTask(${subtask.id})">
              <div class="subtask-text">${subtask.title}</div>
              <button class="btn-small btn-delete" onclick="deleteTask(${subtask.id})">削除</button>
            </li>
          `).join('')}
        </ul>
      ` : '';

      return `
        <li class="task-item ${task.is_completed ? 'completed' : ''} ${urgencyClass}">
          <input type="checkbox" class="task-checkbox" ${task.is_completed ? 'checked' : ''} 
                 onchange="toggleTask(${task.id})">
          <div class="task-content">
            <div class="task-text">${task.title}</div>
            <div class="task-meta">
              <span class="${getPriorityClass(task.priority)}">${getPriorityLabel(task.priority)}</span>
              ${task.deadline ? `<span class="countdown ${countdown.class}">${countdown.text}</span>` : ''}
              ${task.duration_minutes > 0 ? `<span>${task.duration_minutes}分</span>` : ''}
              ${tagBadge}
            </div>
            ${subtaskHtml}
          </div>
          <div class="task-actions">
            <button class="btn-small" onclick="openSubtaskModal(${task.id})">タスクを細分化</button>
            <button class="btn-small" onclick="openEditModal(${task.id})" style="background: #2980b9; color: white !important;">編集</button>
            <button class="btn-small btn-delete" onclick="deleteTask(${task.id})" style="color: white !important;">削除</button>
          </div>
        </li>
      `;
    };

    const render = () => {
      const taskList = document.getElementById('taskList');
      const filtered = getFilteredTasks();
      const sorted = getSortedTasks(filtered);

      if (sorted.length === 0) {
        taskList.innerHTML = `
          <div class="empty-state">
            <p>タスクはありません</p>
            <p style="font-size: 0.9em; margin-top: 10px;">「新規追加」ボタンからタスクを追加してください</p>
          </div>
        `;
        return;
      }

      taskList.innerHTML = sorted.map(task => renderTaskItem(task)).join('');
    };

    // モーダルの外側をクリックで閉じる
    document.getElementById('addModal').addEventListener('click', (e) => {
      if (e.target.id === 'addModal') {
        closeAddModal();
      }
    });

    document.getElementById('editModal').addEventListener('click', (e) => {
      if (e.target.id === 'editModal') {
        closeEditModal();
      }
    });

    document.getElementById('subtaskModal').addEventListener('click', (e) => {
      if (e.target.id === 'subtaskModal') {
        closeSubtaskModal();
      }
    });

    document.getElementById('routineModal').addEventListener('click', (e) => {
      if (e.target.id === 'routineModal') {
        closeRoutineModal();
      }
    });

    // 初期化ロード
    loadTasks();
    loadRoutines();
    loadCompletions();

    // 1分ごとにカウントダウンを更新
    setInterval(() => {
      render();
    }, 60000);
  </script>
</body>
</html>
